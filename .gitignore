# Training artefacts: keep final models, demos, eval metrics, and logs.
# Drop intermediate checkpoints, TensorBoard event files, and any actively-running session.
runs/*/checkpoints/
runs/*/tb/
runs/sac_lift_v1/
runs/sac_lift_v1_train.log

# Cloned external dependency (fetch via `git clone https://github.com/google-deepmind/mujoco_menagerie.git third_party/mujoco_menagerie`)
third_party/

# SO-100 mesh files (derivative of MuJoCo Menagerie; fetch via the setup steps in the README)
scene/assets/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.venv/

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Note: training-output MP4s under runs/ are intentionally tracked
# so reviewers can see what each trained policy actually does.
